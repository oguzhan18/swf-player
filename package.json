{
  "name": "swf-player",
  "version": "1.0.0",
  "description": "Web-based Flash (SWF) game player powered by Ruffle — drag, drop, URL, and recent files.",
  "type": "module",
  "license": "MIT",
  "author": "Oğuzhan ÇART (https://github.com/oguzhan18)",
  "homepage": "https://swf-player-theta.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oguzhan18/swf-player.git"
  },
  "bugs": {
    "url": "https://github.com/oguzhan18/swf-player/issues"
  },
  "keywords": [
    "swf",
